# Which channels are on is normally decided by the plugin registry at
# ~/.yuki-conductor/workspace/plugins.yaml (edit it from the Plugins tab).
# CHANNELS overrides that entirely when set — an escape hatch for when the
# registry is broken or the web UI is unreachable. Comma-separated channel
# names; empty or "none" disables all chat receivers (web + cron still run).
# CHANNELS=slack_socket
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_APP_DM_CHANNEL=D0123456789
SLACK_CRON_CHANNEL=C0123456789
CLAUDE_TIMEOUT=300
CLAUDE_WORKING_DIR=~/Projects/wandering-vibe
# Path or name of the Claude CLI binary (resolved via PATH if unqualified). Default: "claude".
CLAUDE_BIN=claude
SLACK_WORKSPACE=wandermyz
WEB_PORT=2333
